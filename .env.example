# GMI Cloud (OpenAI-compatible). Leave LLM_API_KEY empty to run in Fallback (rule-based) mode.
LLM_BASE_URL=https://api.gmi-serving.com/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
# "low" keeps latency ~6 s on GMI Cloud; set to "off" for models that reject the parameter
LLM_REASONING_EFFORT=low
